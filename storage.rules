rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /media/{userId}/{allPaths=**} {
      // Reads are public so the player can render media from getDownloadURL().
      // Storage objects are referenced by a non-guessable token, so this is
      // effectively "anyone with the link".
      allow read: if true;

      // Writes require the admin custom claim (not just any authenticated user),
      // so a random self-signup account can't use the bucket as free/malware
      // hosting. The admin still writes under its own uid path.
      allow create, update: if request.auth != null
        && request.auth.token.admin == true
        && request.auth.uid == userId
        && request.resource.size < 52 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/(jpeg|png|gif|webp)')
          || request.resource.contentType.matches('video/(mp4|quicktime|webm)')
        );

      allow delete: if request.auth != null
        && request.auth.token.admin == true
        && request.auth.uid == userId;
    }
  }
}
