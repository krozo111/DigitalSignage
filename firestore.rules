rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // SCREENS
    // - Anyone can create (the player page registers new TVs)
    // - Anyone can read a single doc by ID (get), but not list all
    // - Unauthenticated users can ONLY update `lastSeen` and `status`
    // - Only admin (authenticated) can update other fields or delete
    // - Rate limit: max 5 screen creations per IP per hour
    // ============================================================
    match /screens/{screenId} {
      allow get: if true;
      allow list: if request.auth != null;

      // Solo el admin (autenticado) puede borrar registros
      allow delete: if request.auth != null;

      // El player puede registrarse (create) si no está autenticado,
      // pero solo con el nombre por defecto y campos iniciales.
      allow create: if request.auth == null
        && request.resource.data.name == "New TV"
        && request.resource.data.status == "online"
        && request.resource.data.pairingCode is string
        && request.resource.data.pairingCode.size() == 6
        && request.resource.data.keys().hasOnly(['pairingCode', 'name', 'playlistId', 'status', 'lastSeen']);

      // Admin puede actualizar todo.
      // El player NO autenticado SOLO puede actualizar el heartbeat (lastSeen y status).
      allow update: if request.auth != null
        || (request.auth == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'status']));
    }

    // ============================================================
    // PLAYLISTS — get by ID for anyone, list only for admin
    // ============================================================
    match /playlists/{playlistId} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // ============================================================
    // MEDIA — get by ID for anyone, list only for admin
    // ============================================================
    match /media/{mediaId} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }
  }
}
