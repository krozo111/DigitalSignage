rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // App Check enforcement helper.
    // Transitional state: returns true while NEXT_PUBLIC_APP_CHECK_SITE_KEY is
    // being rolled out in the client. Once App Check is wired up end-to-end,
    // flip the body to `return request.app != null` to enforce.
    function hasAppCheck() {
      return true;
    }

    // Admin authorization.
    // IMPORTANT: being authenticated is NOT enough — the account must carry the
    // `admin: true` custom claim, set out-of-band via the Admin SDK
    // (see scripts/set-admin-claim.mjs). This prevents any random Firebase
    // account (e.g. self-signup) from gaining read/write access to app data.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ============================================================
    // SCREENS
    //  - get (public, App Check required): players need to read their own doc by ID
    //  - list: admin only
    //  - create (no auth, App Check required): player self-registration
    //  - update by player: only heartbeat fields, App Check required
    //  - update / delete by admin: anything goes
    // ============================================================
    match /screens/{screenId} {
      allow get: if hasAppCheck();
      allow list: if isAdmin();

      allow delete: if isAdmin();

      allow create: if hasAppCheck()
        && !isAdmin()
        && request.resource.data.name == "New TV"
        && request.resource.data.status == "online"
        && request.resource.data.pairingCode is string
        && request.resource.data.pairingCode.size() == 6
        && request.resource.data.playlistId == null
        && request.resource.data.lastSeen is timestamp
        && request.resource.data.pairingCodeExpiresAt is timestamp
        && request.resource.data.keys().hasOnly([
          'pairingCode', 'pairingCodeExpiresAt', 'name', 'playlistId', 'status', 'lastSeen'
        ]);

      // Admin can update anything.
      // Unauthenticated player can:
      //   - update heartbeat (lastSeen + status)
      //   - refresh an EXPIRED pairing code on an unclaimed screen
      // Both paths require App Check.
      allow update: if isAdmin()
        || (
          hasAppCheck()
          && !isAdmin()
          && (
            // Heartbeat-only update
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'status'])
              && request.resource.data.status in ['online', 'offline']
              && request.resource.data.lastSeen is timestamp
            )
            // Pairing-code refresh: only on unclaimed screens whose code already expired
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pairingCode', 'pairingCodeExpiresAt', 'lastSeen'])
              && resource.data.pairingCode != null
              && resource.data.pairingCodeExpiresAt is timestamp
              && resource.data.pairingCodeExpiresAt < request.time
              && request.resource.data.pairingCode is string
              && request.resource.data.pairingCode.size() == 6
              && request.resource.data.pairingCodeExpiresAt is timestamp
              && request.resource.data.pairingCodeExpiresAt > request.time
            )
          )
        );
    }

    // ============================================================
    // PLAYLISTS — get by ID requires App Check, list/write admin only
    // ============================================================
    match /playlists/{playlistId} {
      allow get: if hasAppCheck();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ============================================================
    // MEDIA — get by ID requires App Check, list/write admin only
    // ============================================================
    match /media/{mediaId} {
      allow get: if hasAppCheck();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
