rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // App Check must be enforced in Firebase Console at the product boundary.
    // Firestore rules do not expose an App Check claim, so this helper cannot
    // validate it. Confirm Console enforcement before releasing these rules.
    function allowPublicPlayerOperation() {
      return true;
    }

    // Admin authorization.
    // IMPORTANT: being authenticated is NOT enough — the account must carry the
    // `admin: true` custom claim, set out-of-band via the Admin SDK
    // (see scripts/set-admin-claim.mjs). This prevents any random Firebase
    // account (e.g. self-signup) from gaining read/write access to app data.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ============================================================
    // SCREENS
    //  - get (public; requires Console App Check enforcement): player reads by ID
    //  - list: admin only
    //  - create (no auth): player self-registration; Console App Check enforcement is required
    //  - update by player: heartbeat/pairing refresh; Console App Check enforcement is required
    //  - update / delete by admin: anything goes
    // ============================================================
    match /screens/{screenId} {
      allow get: if allowPublicPlayerOperation();
      allow list: if isAdmin();

      allow delete: if isAdmin();

      allow create: if allowPublicPlayerOperation()
        && !isAdmin()
        && request.resource.data.name == "New TV"
        && request.resource.data.status == "online"
        && request.resource.data.pairingCode is string
        && request.resource.data.pairingCode.matches('^[A-Z0-9]{6}$')
        && request.resource.data.playlistId == null
        && request.resource.data.lastSeen == request.time
        && request.resource.data.pairingCodeExpiresAt is timestamp
        && request.resource.data.keys().hasOnly([
          'pairingCode', 'pairingCodeExpiresAt', 'name', 'playlistId', 'status', 'lastSeen'
        ]);

      // Admin can update anything.
      // Unauthenticated player can:
      //   - update heartbeat (lastSeen + status)
      //   - acknowledge the latest admin command without changing it
      //   - refresh an EXPIRED pairing code on an unclaimed screen
      // Both player paths rely on App Check enforcement in Firebase Console.
      allow update: if isAdmin()
        || (
          allowPublicPlayerOperation()
          && !isAdmin()
          && (
            // Heartbeat-only update
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'status'])
              && request.resource.data.status in ['online', 'offline']
              && request.resource.data.lastSeen == request.time
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['controlAck'])
              && resource.data.controlCommand is map
              && request.resource.data.controlAck is map
              && request.resource.data.controlAck.keys().hasOnly(['id', 'status', 'at'])
              && request.resource.data.controlAck.id == resource.data.controlCommand.id
              && request.resource.data.controlAck.status in ['applied', 'unsupported', 'failed']
              && request.resource.data.controlAck.at == request.time
            )
            // Pairing-code refresh: only on unclaimed screens whose code already expired
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pairingCode', 'pairingCodeExpiresAt', 'lastSeen'])
              && resource.data.pairingCode != null
              && resource.data.pairingCodeExpiresAt is timestamp
              && resource.data.pairingCodeExpiresAt < request.time
              && request.resource.data.pairingCode is string
              && request.resource.data.pairingCode.matches('^[A-Z0-9]{6}$')
              && request.resource.data.pairingCodeExpiresAt is timestamp
              && request.resource.data.pairingCodeExpiresAt > request.time
              && request.resource.data.lastSeen == request.time
            )
          )
        );
    }

    // ============================================================
    // PLAYLISTS — public get relies on Console App Check enforcement; list/write admin only
    // ============================================================
    match /playlists/{playlistId} {
      allow get: if allowPublicPlayerOperation();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ============================================================
    // MEDIA — public get relies on Console App Check enforcement; list/write admin only
    // ============================================================
    match /media/{mediaId} {
      allow get: if allowPublicPlayerOperation();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
