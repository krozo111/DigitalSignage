# ============================================================
# Firebase client SDK (publicly exposed by design — App Check
# is what actually protects abuse, not these values).
# Get them from Firebase Console → Project settings → General → Your apps.
# ============================================================
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ============================================================
# Firebase App Check — reCAPTCHA v3 site key
# Register your site in Firebase Console → App Check → Web app → reCAPTCHA v3.
# Without this set, App Check is not initialized in development and production
# builds fail. Enforcement is configured in Firebase Console for Cloud
# Firestore and Cloud Storage, not in these rules.
# Keep enforcement OFF in the console until you've verified the site key works,
# then enable it and verify a real player can pair and play.
# ============================================================
NEXT_PUBLIC_APP_CHECK_SITE_KEY=""

# Optional: register a debug token in Firebase Console → App Check → Debug tokens,
# then paste its value here for local development. Never commit a real token.
# NEXT_PUBLIC_APP_CHECK_DEBUG_TOKEN=""

# ============================================================
# Server-only — the single allowed admin email
# ============================================================
ADMIN_EMAIL=""

# Local TV remote — development server on the paired Mac only
# Set this in .env.local to show controls in Admin → Screens.
# The API route is disabled in production.
# LOCAL_TV_CONTROL_ENABLED="true"
# LOCAL_TV_PYTHON="/absolute/path/to/mi-signage/.local/tv-remote-venv/bin/python"

# ============================================================
# Firebase Admin SDK — required in production
# (Vercel/Netlify env vars). In local dev, gcloud ADC works.
# Generate from Firebase Console → Project settings → Service accounts.
# Remember to keep the \n escapes in the private key.
# ============================================================
# FIREBASE_ADMIN_CLIENT_EMAIL="firebase-adminsdk-xxxxx@<project>.iam.gserviceaccount.com"
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
